<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      独立模块，不挂在 Spring Boot 父 POM 下。
      原因：Spark 和 Flink 都捆绑了大量第三方库（Netty、Jackson、Scala 等），
      放在同一个 Maven 模块里会让编译期 classpath 出现版本冲突。
      分开两个模块，各自只声明自己需要的依赖，互不干扰。

      目前是独立模块。等阶段 1 做多模块重构时，这里加一个 <parent> 即可。
    -->
    <groupId>com.company</groupId>
    <artifactId>shop-insight-spark</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>shop-insight-spark</name>
    <description>Spark 离线计算任务：漏斗、留存、RFM 分群</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Spark 4.x 用 Scala 2.13，不是老教程里的 2.12。
          本机装的 Spark 是 4.2.0，这里必须对齐 —— 版本不一致会在提交时报
          NoSuchMethodError 之类的错。
        -->
        <spark.version>4.2.0</spark.version>
        <scala.binary.version>2.13</scala.binary.version>
    </properties>

    <dependencies>
        <!--
          Spark 由集群（这里是本地 spark-submit）提供，不打进 fat jar。
          scope=provided 既让编译期能找到类，又不会打进产物。
        -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          MLlib 是独立工件，不包含在 spark-sql 里。
          RFM 分群用它的 KMeans —— 这也是「为什么要保留 Spark」的答案：
          spark-sql 能做的 SQL 也能做，但聚类不能。
        -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-mllib_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              不需要 ClickHouse JDBC 依赖：我们只用 JDBC URL 字符串，
              不直接引用驱动的类。驱动在提交时由 spark-submit 的 jars 参数提供。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
